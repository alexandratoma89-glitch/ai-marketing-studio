NEXT_PUBLIC_TURNSTILE_SITE_KEY=
AI_API_KEY=
TAROT_AI_MODEL=
RESEND_API_KEY=
TAROT_EMAIL_FROM=
RESEND_WEBHOOK_SECRET=
# Only set true after completing the published privacy notice.
TAROT_PRIVACY_READY=false
# Optional HTTPS links. No checkout, subscription, or payment is activated by this project.
TAROT_BOOKING_URL=
TAROT_SUBSCRIPTION_URL=
