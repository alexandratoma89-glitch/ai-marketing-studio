# Copy names only into Vercel's environment settings. Never commit real values.
TAROT_SITE_URL=http://localhost:3000
# Server-only Supabase EU test project. Apply BOTH SQL migrations before marking ready.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
TAROT_DATABASE_READY=false
COMMERCE_DATABASE_READY=false
TAROT_IP_HASH_SECRET=
# Free reading email can be enabled separately; paid-service email remains source-locked.
TAROT_EMAIL_MODE=mock
TAROT_PRIVACY_READY=false
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_REPLY_TO=
BREVO_WEBHOOK_SECRET=
# Captcha required on hosted production/test deployment. No production bypass.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Only test Stripe keys are accepted. Live keys/events are rejected in code.
COMMERCE_MODE=disabled
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Independent 32+ character random secrets. Do not reuse the studio password.
COMMERCE_TOKEN_SECRET=
CRON_SECRET=
COMMERCE_JOBS_ENABLED=false
# Existing private studio authentication; 24+ character unique password.
STUDIO_USERNAME=
STUDIO_PASSWORD=
# Future live AI integration, unused in this test-only release.
AI_API_KEY=
TAROT_AI_MODEL=
# Romanian TEST offers are final customer totals in lei. Tax status is not yet confirmed.
COMMERCE_TAX_STATUS=unconfirmed
# Only for a future confirmed VAT-inclusive test configuration; must be an active,
# inclusive, non-live Stripe tax rate. No statutory percentage is assumed here.
STRIPE_TEST_INCLUSIVE_TAX_RATE_ID=

# Instagram Login (server only). Never use NEXT_PUBLIC_ for these credentials.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Exactly 64 hexadecimal characters (32 random bytes). Keep secure backups; rotation needs re-encryption/reconnection.
INSTAGRAM_TOKEN_ENCRYPTION_KEY=
INSTAGRAM_EXPECTED_USERNAME=divinework.store
INSTAGRAM_GRAPH_VERSION=v24.0
INSTAGRAM_DATABASE_READY=false
# Exact public video storage hostnames, comma-separated, no scheme or paths.
INSTAGRAM_VIDEO_HOSTS=
# Keep false until real OAuth and a deliberately approved publishing test.
INSTAGRAM_PUBLISHING_ENABLED=false
# Uses the existing CRON_SECRET (at least 32 random characters). Never expose it publicly.

# Server-only Runway diagnostic. No generation endpoints or automatic generation are enabled.
RUNWAYML_API_SECRET=
# Runway single test: leave paid generation disabled until explicit owner authorization.
RUNWAY_DATABASE_READY=false
RUNWAY_PAID_TEST_ENABLED=false
RUNWAY_PRICING_CONFIRMED=false
RUNWAY_MONTHLY_CREDIT_LIMIT=60
RUNWAY_TEST_CREDIT_LIMIT=60
RUNWAY_OUTPUT_HOSTS=dnznrvs05pmza.cloudfront.net
# Create private Supabase Storage bucket: runway-videos (MP4, max 32 MiB).

# Optional Facebook/TikTok/YouTube read-only OAuth connections. No publishing endpoints.
SOCIAL_DATABASE_READY=false
# 64 random hexadecimal characters; server-only, separate from the Instagram key.
SOCIAL_TOKEN_ENCRYPTION_KEY=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Numeric Page ID; handle alone is not sufficient.
FACEBOOK_PAGE_ID=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Requested 10% welcome offer only; no newsletter subscription or other live email is enabled.
# Apply 202610290007_welcome_email.sql first. Configure Brevo sender + domain DNS separately.
WELCOME_DATABASE_READY=false
WELCOME_EMAIL_ENABLED=false
# Set true only after Brevo shows the sender/domain authenticated.
WELCOME_SENDER_VERIFIED=false
# Uses existing BREVO_API_KEY, BREVO_SENDER_EMAIL, BREVO_REPLY_TO,
# TAROT_SITE_URL, TAROT_IP_HASH_SECRET and Turnstile variables above.
WELCOME_PRIVACY_READY=false
# Public identity/contact shown on the privacy page; never place secrets here.
BUSINESS_OPERATOR_NAME=
BUSINESS_CONTACT_EMAIL=

# Sandbox booking invoices. Apply migration 008, then enable both. No live invoices.
COMMERCE_INVOICES_DATABASE_READY=false
COMMERCE_INVOICES_ENABLED=false

# Own uploaded videos only. Apply migration 009; private own-videos bucket (MP4, 50 MiB).
OWN_VIDEOS_DATABASE_READY=false
OWN_VIDEOS_ENABLED=false
# Enable one platform at a time after reconnecting with publishing permissions.
OWN_VIDEOS_INSTAGRAM_ENABLED=false
OWN_VIDEOS_FACEBOOK_ENABLED=false
OWN_VIDEOS_YOUTUBE_ENABLED=false
# Requires existing CRON_SECRET >=32 chars, existing Instagram + social encryption keys.
# TikTok remains manual. Existing Runway/AI publication locks are unchanged.

# Bilingual customer accounts and private journal (separate from Studio Basic auth).
# Apply migration 014 and configure Supabase Auth before enabling.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
JOURNAL_DATABASE_READY=false
# Apply migration 015 before enabling localized booking/membership checkout.
PUBLIC_PLATFORM_DATABASE_READY=false

# Free requested readings only. Never enables paid membership/booking email or charges.
# Keep mock until the sender/domain, privacy text and webhook are verified.
FREE_READING_EMAIL_ENABLED=false
FREE_READING_SENDER_VERIFIED=false

# Optional marketing sync and campaign drafts (separate from free-reading delivery).
# Apply 202611160016_marketing.sql; create an EMPTY dedicated Brevo list first.
MARKETING_DATABASE_READY=false
BREVO_MARKETING_ENABLED=false
# Separate API key: Contacts All + Email campaigns All. Never use an SMTP key.
BREVO_MARKETING_API_KEY=
BREVO_MARKETING_LIST_ID=
# Independent Bearer token, >=32 characters, for Marketing email webhook.
BREVO_MARKETING_WEBHOOK_SECRET=
# Reuses existing verified BREVO_SENDER_EMAIL, BUSINESS_* and CRON_SECRET.
# Campaign creation is draft-only. Review/test/send in Brevo; never auto-broadcast.

# Vercel Hobby: jobs are scheduled through .github/workflows/website-jobs.yml.
# Set the same new random token (>=32 characters) as a GitHub Actions repository secret.
# Existing CRON_SECRET remains valid; do not replace it or Studio credentials.
SCHEDULER_SECRET=
