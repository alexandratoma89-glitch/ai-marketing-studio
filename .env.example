# Copy names only into Vercel's environment settings. Never commit real values.
TAROT_SITE_URL=http://localhost:3000
# Server-only Supabase EU test project. Apply BOTH SQL migrations before marking ready.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
TAROT_DATABASE_READY=false
COMMERCE_DATABASE_READY=false
TAROT_IP_HASH_SECRET=
# Free readings and all commerce email remain MOCK. Real sending is source-locked.
TAROT_EMAIL_MODE=mock
TAROT_PRIVACY_READY=false
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_REPLY_TO=
BREVO_WEBHOOK_SECRET=
# Captcha required on hosted production/test deployment. No production bypass.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Only test Stripe keys are accepted. Live keys/events are rejected in code.
COMMERCE_MODE=disabled
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Independent 32+ character random secrets. Do not reuse the studio password.
COMMERCE_TOKEN_SECRET=
CRON_SECRET=
COMMERCE_JOBS_ENABLED=false
# Existing private studio authentication; 24+ character unique password.
STUDIO_USERNAME=
STUDIO_PASSWORD=
# Future live AI integration, unused in this test-only release.
AI_API_KEY=
TAROT_AI_MODEL=
# Romanian TEST offers are final customer totals in lei. Tax status is not yet confirmed.
COMMERCE_TAX_STATUS=unconfirmed
# Only for a future confirmed VAT-inclusive test configuration; must be an active,
# inclusive, non-live Stripe tax rate. No statutory percentage is assumed here.
STRIPE_TEST_INCLUSIVE_TAX_RATE_ID=

# Instagram Login (server only). Never use NEXT_PUBLIC_ for these credentials.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Exactly 64 hexadecimal characters (32 random bytes). Keep secure backups; rotation needs re-encryption/reconnection.
INSTAGRAM_TOKEN_ENCRYPTION_KEY=
INSTAGRAM_EXPECTED_USERNAME=divinework.store
INSTAGRAM_GRAPH_VERSION=v24.0
INSTAGRAM_DATABASE_READY=false
# Exact public video storage hostnames, comma-separated, no scheme or paths.
INSTAGRAM_VIDEO_HOSTS=
# Keep false until real OAuth and a deliberately approved publishing test.
INSTAGRAM_PUBLISHING_ENABLED=false
# Uses the existing CRON_SECRET (at least 32 random characters). Never expose it publicly.

# Server-only Runway diagnostic. No generation endpoints or automatic generation are enabled.
RUNWAYML_API_SECRET=
