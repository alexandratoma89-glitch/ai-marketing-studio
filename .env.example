# Local development works with no credentials and NEVER sends real email.
# Live email is authorized, but stays OFF until every prerequisite and activation flag is set.
TAROT_SITE_URL=http://localhost:3000
# Server-only. Never use NEXT_PUBLIC_ for secrets.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
TAROT_IP_HASH_SECRET=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
AI_API_KEY=
TAROT_AI_MODEL=
RESEND_API_KEY=
TAROT_EMAIL_FROM=
RESEND_WEBHOOK_SECRET=
# Only set true after completing the published privacy notice.
TAROT_PRIVACY_READY=false
# Optional HTTPS links. No checkout, subscription, or payment is activated by this project.
TAROT_BOOKING_URL=
TAROT_SUBSCRIPTION_URL=

# Private /studio login. Set only in hosting settings; no real passwords in Git.
STUDIO_USERNAME=
# Use a unique password-manager-generated password of at least 24 characters.
STUDIO_PASSWORD=

# Set only after the Supabase migration has been applied to the intended project.
TAROT_DATABASE_READY=false
# Paid AI calls and real transactional email require separate explicit activation.
TAROT_AI_ENABLED=false
TAROT_EMAIL_ENABLED=false
# Paid booking: use the scheduler URL with integrated payment, not a detached payment link.
TAROT_BOOKING_VERIFIED=false
TAROT_BOOKING_ENABLED=false
# Not available until the daily fulfillment and cancellation workflow is implemented.
TAROT_SUBSCRIPTION_ENABLED=false
